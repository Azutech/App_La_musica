generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Artist {
  id            String            @id @default(uuid())
  userId        String            @unique               // from Auth microservice
  distributorId String?                           // optional
  distributor   Distributor?      @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  stageName     String            @unique
  realName      String?
  bio           String?
  genre         String?
  followers     Int               @default(0)
  profileImage  String?
  originType    ArtistOriginType  @default(INDEPENDENT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([stageName])
  @@index([genre])
}

enum ArtistOriginType {
  INDEPENDENT
  DISTRIBUTOR
}

model ArtistApplication {
  id        String   @id @default(uuid())
  userId    String
  stageName String
  genre     String?
  bio       String?
  adminNote String?
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Distributor {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  website    String?
  artists    Artist[] // One distributor -> many artists
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}