generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Artist {
  id            String            @id @default(uuid())
  distributorId String?                           // optional
  distributor   Distributor?      @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  isActive      Boolean           @default(false)
  stageName     String            @unique
  realName      String?
  bio           String?
  genre         String?
  followers     Int               @default(0)
  profileImage  String?
  originType    ArtistOriginType  @default(independent)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([stageName])
  @@index([genre])
}

enum ArtistOriginType {
  independent
  distributor
}



model ArtistApplication {
  id            String   @id @default(uuid())
  stageName     String
  genre         String?
  bio           String?
  country       String?
  socialLink    String?
  portfolioLink String?
  documentUrl   String?
  adminNote     String?
  distributorId String?                           // optional
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  status        ApplicationStatus @default(pending)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Distributor {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  isActive   Boolean           @default(false)
  website    String?
  status     Status   @default(pending)
  artists    Artist[] // One distributor -> many artists
  artistApplications ArtistApplication[]  // <-- ADD THIS LINE
  profile     DistributorProfile?
  documents   DistributorDocument[]
  ubos        DistributorUbo[]
  verificationChecks VerificationCheck[]
  payoutAccounts PayoutAccount[]
  tokens      Token[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Status {
  active
  pending
  suspended
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

model Token {
  id            String   @id @default(uuid())
  distributorId String?                           // optional
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  email         String
  code          Int   
  expiresAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  @@index([distributorId])
  @@index([email])
}

model Release {
  id           String        @id @default(uuid())
  title        String
  releaseType  ReleaseType   // album | ep | single
  upc          String?       @unique
  coverArtUrl  String?
  releaseDate  DateTime?
  status       ReleaseStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tracks       Track[]       // one-to-many relation
}

model Track {
  id              String      @id @default(uuid())
  releaseId       String
  release         Release     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  title           String
  isrc            String?     @unique
  position        Int?        // order within release (1, 2, 3, ...)
  previewStart    Int?     // seconds from start
  previewEnd      Int?     // seconds from start
  durationSeconds Int?
  explicit        Boolean     @default(false)
  audioUrl        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}


model DistributorProfile {
  id String     @id @default(uuid())
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  distributorId String @unique
  legalName     String?
  businessType  BusinessType?
  registrationNumber String?
  taxId         String?
  country       String?
  state         String?
  city          String?
  address       String?
  website       String?
  isVerified    Boolean @default(false)
  verificationScore Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model DistributorUbo {
    id String     @id @default(uuid())
    distributor   Distributor @relation(fields: [distributorId], references: [id])
    distributorId String
    firstName     String
    lastName      String
    email         String?
    phone         String?
    nationality   String?
    idType        IdType @default(OTHER)
    idNumber      String?
    idDocumentUrl String?
    ownershipPercentage Decimal @db.Decimal(5,2)
    isVerified Boolean @default(false)
    isSignatory Boolean @default(false)
    createdAt DateTime @default(now())


    @@index([distributorId])
}

model DistributorDocument {
  id String        @id @default(uuid())
  distributor      Distributor @relation(fields: [distributorId], references: [id])
  distributorId    String
  docType          String
  docUrl           String
  docHash          String
  status           DocStatus @default(PENDING)
  rejectionReason  String?
  mimeType         String?
  size             Int?
  uploadedAt       DateTime @default(now())
  @@index([distributorId])
  @@index([docHash])
}


model VerificationCheck {
  id String     @id @default(uuid())
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  distributorId String
  checkType     CheckType
  status        CheckStatus
  score         Int?
  details       Json?
  createdAt     DateTime @default(now())
  @@index([distributorId])
  @@index([checkType, status])
}


model PayoutAccount {
  id String @id @default(uuid())
  distributor Distributor @relation(fields: [distributorId], references: [id])
  distributorId String
  accountName String
  accountNumber String
  bankName String?
  bankCode String?
  currency String @default("USD")
  isVerified Boolean @default(false)
  verificationMethod VerificationMethod?
  createdAt DateTime @default(now())
  @@index([distributorId])
  @@unique([accountNumber, bankCode])
}

enum ReleaseType {
  album
  ep
  single
}

enum ReleaseStatus {
  DRAFT
  PENDING
  RELEASED
}

enum AccountType {
  LABEL
  AGGREGATOR
  PUBLISHER
  INDIE
}


enum OnboardingStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}


enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}


enum DocStatus {
  PENDING
  VERIFIED
  REJECTED
}


enum CheckType {
  AML
  OFAC
  DUPLICATE
  IDENTITY
  DOCUMENT
}


enum CheckStatus {
  PASSED
  FAILED
  MANUAL_REVIEW
}


enum VerificationMethod {
  MICRO_DEPOSIT
  API
  MANUAL
}

enum IdType {
  PASSPORT
  NATIONAL_ID
  DRIVER_LICENSE
  OTHER
}


enum BusinessType {
  LABEL
  AGGREGATOR
  PUBLISHER
  INDIE
  MANAGEMENT
  DISTRIBUTION_COMPANY
  SERVICE_PROVIDER
  OTHER
}