generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum Role {
  USER
  ARTIST
  ADMIN
}

enum Status {
  active
  pending
  suspended
}

model Token {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  code      Int   
  expiresAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String?  
  lastName  String?  
  status    Status   @default(pending)
  role      Role     @default(USER)
  password  String
  createdAt DateTime @default(now())
  tokens    Token[]  

  @@index([email])
}
